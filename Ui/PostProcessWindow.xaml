<Window x:Class="HdrCapture.Ui.PostProcessWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDRCapture 后期处理"
        Icon="pack://application:,,,/Assets/HDRCapture.ico"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Closing="OnWindowClosing">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,12,8">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton x:Name="ProcessedViewButton"
                                 Content="处理后"
                                 IsChecked="True"
                                 GroupName="PreviewView"
                                 VerticalAlignment="Center"
                                 Checked="OnPreviewViewChanged" />
                    <RadioButton x:Name="OriginalViewButton"
                                 Content="原图"
                                 GroupName="PreviewView"
                                 Margin="16,0,0,0"
                                 VerticalAlignment="Center"
                                 Checked="OnPreviewViewChanged" />
                </StackPanel>
                <TextBlock x:Name="ImageInfoText"
                           DockPanel.Dock="Right"
                           Foreground="#666666"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Border Grid.Row="1"
                    Margin="0,0,12,8"
                    Background="#202124"
                    BorderBrush="#D0D4D8"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Margin="8"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <ProgressBar x:Name="BusyBar"
                                 Height="4"
                                 VerticalAlignment="Bottom"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Margin="0,0,12,0"
                       Foreground="#555555"
                       TextWrapping="Wrap"
                       Text="正在准备预览…" />
        </Grid>

        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,0,8"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="截图后期" />

            <StackPanel Grid.Row="1">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="磨皮" />
                    <TextBlock x:Name="SmoothSkinValueText" HorizontalAlignment="Right" Foreground="#555555" />
                </Grid>
                <Slider x:Name="SmoothSkinSlider"
                        Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        SmallChange="0.05"
                        ValueChanged="OnParameterChanged" />

                <Grid Margin="0,8,0,4">
                    <TextBlock Text="降噪" />
                    <TextBlock x:Name="DenoiseValueText" HorizontalAlignment="Right" Foreground="#555555" />
                </Grid>
                <Slider x:Name="DenoiseSlider"
                        Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        SmallChange="0.05"
                        ValueChanged="OnParameterChanged" />

                <Grid Margin="0,8,0,4">
                    <TextBlock Text="提亮" />
                    <TextBlock x:Name="BrightnessValueText" HorizontalAlignment="Right" Foreground="#555555" />
                </Grid>
                <Slider x:Name="BrightnessSlider"
                        Minimum="-2"
                        Maximum="2"
                        TickFrequency="0.1"
                        SmallChange="0.1"
                        ValueChanged="OnParameterChanged" />

                <Grid Margin="0,8,0,4">
                    <TextBlock Text="细节保留" />
                    <TextBlock x:Name="DetailValueText" HorizontalAlignment="Right" Foreground="#555555" />
                </Grid>
                <Slider x:Name="DetailSlider"
                        Minimum="0"
                        Maximum="1"
                        TickFrequency="0.05"
                        SmallChange="0.05"
                        ValueChanged="OnParameterChanged" />
            </StackPanel>

            <Separator Grid.Row="2" Margin="0,14,0,12" />

            <StackPanel Grid.Row="3">
                <TextBlock FontWeight="SemiBold" Text="人像美化" />
                <TextBlock Margin="0,3,0,8"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Text="模型是唯一 AI 参数，其余提示词和采样设置由 HDRCapture 固定。" />
                <ComboBox x:Name="CheckpointBox"
                          MinHeight="30"
                          VerticalContentAlignment="Center"
                          ToolTip="选择 ComfyUI 中的检查点模型" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RefreshModelsButton"
                            Grid.Column="0"
                            Content="刷新模型"
                            Margin="0,0,8,0"
                            Click="OnRefreshModelsClick" />
                    <Button x:Name="PortraitEnhanceButton"
                            Grid.Column="1"
                            Content="人像美化"
                            MinWidth="96"
                            Click="OnPortraitEnhanceClick" />
                </Grid>
            </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                    <TextBlock FontWeight="SemiBold" Text="可选身份保护" />
                    <TextBlock x:Name="IpAdapterStatusText"
                               Margin="0,3,0,6"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               Text="正在检查 IP-Adapter Face…" />
                    <Button x:Name="InstallIpAdapterButton"
                            Content="补充 IP-Adapter Face…"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="OnInstallIpAdapterClick" />
                </StackPanel>

                <StackPanel Grid.Row="5"
                            Margin="0,0,0,12"
                            Orientation="Horizontal">
                    <Button x:Name="CancelButton"
                            Content="取消处理"
                            IsEnabled="False"
                            Click="OnCancelClick" />
                    <Button x:Name="OpenComfyButton"
                            Content="打开 ComfyUI 设置"
                            Margin="8,0,0,0"
                            Click="OnOpenComfySettingsClick" />
                </StackPanel>

                <TextBlock x:Name="HintText"
                           Grid.Row="6"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Text="原始 EXR 不会被覆盖。AI 结果只有点击复制或保存后才写出。" />

                <Grid Grid.Row="7" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CopyButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="复制到剪贴板"
                            Margin="0,0,4,6"
                            Click="OnCopyClick" />
                    <Button x:Name="SavePngButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="保存 PNG"
                            Margin="4,0,0,6"
                            Click="OnSavePngClick" />
                    <Button x:Name="SaveExrButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Content="另存降噪 EXR"
                            Margin="0,0,0,6"
                            Click="OnSaveExrClick" />
                    <Button Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Content="关闭"
                            IsCancel="True"
                            Click="OnCloseClick" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
