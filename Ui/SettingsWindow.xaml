<Window x:Class="HdrCapture.Ui.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDRCapture 设置"
        Icon="pack://application:,,,/Assets/HDRCapture.ico"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="快捷键" VerticalAlignment="Center" />
        <TextBox x:Name="HotkeyBox"
                 Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 Padding="8,4"
                 PreviewKeyDown="OnHotkeyPreviewKeyDown"
                 PreviewKeyUp="OnHotkeyPreviewKeyUp"
                 ToolTip="点击后按下新的组合键" />

        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Margin="0,6,0,14"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Text="必须包含 Ctrl / Alt / Shift / Win，或单独使用 F1–F24、PrintScreen、Pause、ScrollLock。冲突的组合键无法保存。" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="HDR 文件" VerticalAlignment="Center" />
        <CheckBox x:Name="SaveExrBox"
                  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                  Content="保存 HDR EXR 到本地目录"
                  VerticalAlignment="Center"
                  Checked="OnSaveExrChanged"
                  Unchecked="OnSaveExrChanged" />

        <TextBlock x:Name="SaveExrHelpText"
                   Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                   Margin="0,6,0,14"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Text="默认只复制 LDR 图片到剪贴板，不写入 EXR 文件。" />

        <TextBlock x:Name="DirectoryLabel"
                   Grid.Row="4" Grid.Column="0"
                   Text="保存目录"
                   VerticalAlignment="Center" />
        <TextBox x:Name="DirectoryBox" Grid.Row="4" Grid.Column="1" Padding="8,4" />
        <Button x:Name="BrowseButton"
                Grid.Row="4" Grid.Column="2"
                Content="浏览..."
                Margin="8,0,0,0"
                Click="OnBrowseClick" />

        <TextBlock x:Name="DirectoryHelpText"
                   Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                   Margin="0,6,0,14"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Text="EXR 会保存在此目录，目录不存在时自动创建。" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="预览画质" VerticalAlignment="Center" />
        <ComboBox x:Name="PreviewQualityBox"
                  Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                  MinHeight="30"
                  VerticalContentAlignment="Center"
                  ToolTip="选择冻结截图遮罩使用的预览分辨率。">
            <ComboBoxItem Content="高：全分辨率" />
            <ComboBoxItem Content="中：1/2 分辨率" />
            <ComboBoxItem Content="低：最长边 1920 像素" />
        </ComboBox>

        <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                   Margin="0,6,0,14"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Text="高画质使用显示器原生分辨率；中画质宽高各减半；低画质限制最长边为 1920 像素。" />

        <TextBlock Grid.Row="8" Grid.Column="0" Text="曝光补偿" VerticalAlignment="Center" />
        <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="ExposureSlider"
                    Grid.Column="0"
                    Minimum="-3"
                    Maximum="3"
                    TickFrequency="0.1"
                    SmallChange="0.1"
                    LargeChange="0.5"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="OnExposureChanged" />
            <TextBlock x:Name="ExposureText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"
                   Margin="0,6,0,14"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Text="只影响复制到剪贴板的 PNG，写入 EXR 的始终是原始线性 HDR 数据。" />

        <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <CheckBox x:Name="StartWithWindowsBox" Content="开机启动" VerticalAlignment="Center" />
            <CheckBox x:Name="IncludeCursorBox" Content="截图包含鼠标指针" Margin="24,0,0,0" VerticalAlignment="Center" />
            <Button Content="保存" Width="88" Margin="28,0,0,0" IsDefault="True" Click="OnSaveClick" />
            <Button Content="取消" Width="88" Margin="8,0,0,0" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
